rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== PRIMITIVE HELPERS ====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'ramesh.s812758@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedStringList(val, maxItems) {
      return val is list
        && val.size() <= maxItems
        && (val.size() == 0 || (val[0] is string && val[0].size() <= 80));
    }

    // ==================== VALIDATION BLUEPRINTS ====================

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'department',
          'academicYear',
          'interests',
          'preferredSubjects',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('department' in data) || (data.department is string && data.department.size() <= 100))
        && (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 40))
        && (!('interests' in data) || isBoundedStringList(data.interests, 15))
        && (!('preferredSubjects' in data) || isBoundedStringList(data.preferredSubjects, 15))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'studentCode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('studentCode' in data) || (data.studentCode is string && data.studentCode.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'assignedAt'])
        && data.keys().hasOnly(['uid', 'assignedAt'])
        && isValidId(data.uid)
        && data.assignedAt is timestamp;
    }

    // ==================== COLLECTION RULES ====================

    // Trusted Admin Markers
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isBootstrappedAdmin()
        && isValidId(adminUid)
        && isValidAdminMarker(incoming())
        && incoming().uid == adminUid
        && incoming().assignedAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(adminUid);
    }

    // Non-PII User Library Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'department',
              'academicYear',
              'interests',
              'preferredSubjects',
              'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII Contact Subcollection (Master Gate checks parent profile)
      match /private/{docId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'contact'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'contact'
          && isValidUserPrivateInfo(incoming())
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'studentCode', 'updatedAt'])
            )
          );
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }
  }
}
